#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
# APP_NAME: the human-friendly name of the site, shown in the browser tab,
#           emails and the public layout. It can be overridden from the admin
#           "Settings" panel once a site_name setting is saved.
APP_NAME="Blog Platform"

# APP_ENV: the environment this install runs in.
#   local  – your machine, debug on, verbose logs, no caching
#   staging– pre-production, secrets off, realistic behaviour
#   production – live site, APP_DEBUG must be false
APP_ENV=local

# APP_KEY: generated by `php artisan key:generate`. Never reuse the same key
#          across environments, and never commit a real key.
APP_KEY=

# APP_DEBUG: true during development, ALWAYS false in production. When false,
#            detailed error messages are replaced with a generic 500 page.
APP_DEBUG=true

# APP_URL: the base URL the site is served from (no trailing slash). Must be
#          the canonical, publicly reachable URL in production so that
#          sitemap.xml, robots.txt and canonical tags are generated correctly.
APP_URL=http://localhost

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode (see `php artisan down`)
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
# LOG_CHANNEL: stack, single, daily, stderr, syslog, errorlog
# LOG_LEVEL: debug, info, notice, warning, error, critical, alert, emergency.
#            Use "warning" or higher in production to avoid noise.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Database
#--------------------------------------------------------------------------
# Production: use a managed MySQL/MariaDB instance with a dedicated user that
# only has privileges on this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_platform
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# Sessions
#--------------------------------------------------------------------------
# SESSION_DRIVER: database, file, redis, cookie. "database" is recommended.
# SESSION_SECURE_COOKIE: set to true when served over HTTPS (forces the
#                        cookie to only be sent on secure connections).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

#--------------------------------------------------------------------------
# Cache
#--------------------------------------------------------------------------
# CACHE_STORE: database, file, redis, memcached. A distributed store (redis or
#              memcached) is recommended in production behind multiple workers.
#              The site settings and popular/trending posts are cached here.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Queue / Broadcasting
#--------------------------------------------------------------------------
# QUEUE_CONNECTION: database, redis, sync. Use a real worker in production
#                   (`php artisan queue:work`) with database or redis so that
#                   email notifications are delivered reliably.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

#--------------------------------------------------------------------------
# Filesystem / Storage
#--------------------------------------------------------------------------
# FILESYSTEM_DISK: local or s3. Uploaded media (post images, media library)
#                  is stored on the "public" disk and served via
#                  `php artisan storage:link`. In production consider a CDN
#                  or object storage in front of the public directory.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------------
# MAIL_MAILER: log, smtp, mailgun, ses, postmark. Use "log" for local
#              development, "smtp" or a provider driver in production.
# MAIL_FROM_ADDRESS/NAME: the "From" address used for transactional mail such
#                         as password resets, notifications and the contact
#                         form. Must match the sending domain in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Blog Platform
#--------------------------------------------------------------------------
# Recipient of contact form submissions (falls back to MAIL_FROM_ADDRESS).
# BLOG_CONTACT_RECIPIENT=

# Maximum accepted size for uploaded images, in kilobytes.
# BLOG_IMAGE_MAX_KB=5120

# Approve new comments automatically (true) or hold them for moderation (false).
# BLOG_COMMENTS_AUTO_APPROVE=false

# The name used as the "from" name on newsletter mailings.
# BLOG_NEWSLETTER_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Frontend
#--------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
